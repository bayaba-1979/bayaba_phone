# 🔐 S21 생태계 비밀 환경변수 스키마 (23키)
# ─────────────────────────────────────────────────────────────
# 📍 이 파일은 "스키마"다. 실제 값은 절대 넣지 말 것.
#    navigator.sh 가 이 스키마로 `.secrets.env` 를 생성한다.
#    `.secrets.env` 는 .gitignore 에 등록돼 있어 절대 git 에 올라가지 않는다.
#
# ⚠️  실수 1커밋 = 전 키 유출. 커밋 전 `git status` 로 .secrets.env 가
#     staged 되지 않았는지 반드시 확인.
# ─────────────────────────────────────────────────────────────

# ── GitHub (권장: navigator 가 `gh auth` 로 처리 → 여기엔 불필요) ──
# GITHUB_TOKEN=""   # PAT 비커밋 원칙 — gh auth 를 쓰면 이 줄은 빼도 됨

# ── Telegram (BotFather) ───────────────────────────────────────
# 발급: @BotFather → /newbot → 봇 이름/아이디 → 토큰 복사
TG_TOKEN=""
# 채팅방 ID: @userinfobot 또는 @getidsbot 에게 메시지를 보내면 숫자 ID 확인
TG_CHAT=""

# 레포별 전용 봇(고급 — 각 레포의 로그를 따로 보낼 때). 초기엔 비워도 됨.
HELENA_PIANO_TG_TOKEN=""
HELENA_PIANO_TG_CHAT=""
HELENA_PSYCARE_TG_TOKEN=""
HELENA_PSYCARE_TG_CHAT=""
HELENA_FAITH_TG_TOKEN=""
HELENA_FAITH_TG_CHAT=""
HELANA_LOG_TG_TOKEN=""
HELANA_LOG_TG_CHAT=""

# ── 티스토리 (자동 발행 로그인) ─────────────────────────────────
# 카카오 계정 이메일/비번 (tistory-naver/post.py 가 세션 쿠키 발급용)
TISTORY_EMAIL=""
TISTORY_PW=""

# ── YouTube (Google Cloud Console OAuth) ───────────────────────
# 발급: console.cloud.google.com → 프로젝트 생성 → API 사용 설정(YouTube Data v3)
#     → 사용자 인증 정보 → OAuth 2.0 클라이언트 ID (데스크톱 앱)
#     → 클라이언트 ID/시크릿 복사. YouTube 스코프: youtube.upload, youtube.readonly
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
# 아래 두 값은 scripts/yt_oauth_setup.sh 가 최초 실행 시 자동 발급(비워두면 됨)
YOUTUBE_ACCESS_TOKEN=""
YOUTUBE_REFRESH_TOKEN=""

# ── Discord (보고 웹훅/봇 — 선택) ────────────────────────────────
# 발급: discord.com/developers/applications → New Application → Bot → 토큰 복사
#     채널 ID/서버 ID: Discord 설정 → 고급 → 개발자 모드 ON → 우클릭 → ID 복사
DISCORD_BOT_TOKEN=""
DISCORD_CHANNEL_ID=""
DISCORD_SERVER_ID=""
# API 로그인용 계정(선택 — 보고 자동화가 필요할 때만)
DISCORD_EMAIL=""
DISCORD_PASS=""

# ── Tailscale (원격 접속 — 선택) ────────────────────────────────
# 발급: login.tailscale.com/admin → Settings → Keys → Generate auth key
TAILSCALE_API_KEY=""
TAILSCALE_AUTH_KEY=""
